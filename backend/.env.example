NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/pulsehire
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Comma-separated frontend origins allowed to send credentialed requests.
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run create-admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_FULLNAME=PulseHire Admin
ADMIN_PHONE=9999999999
