# =========================================================
# PulseHire Frontend - .gitignore
# =========================================================

# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Vite
dist/
.vite/

# Build output
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
.nyc_output/
*.lcov

# Cache
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/

# TypeScript generated files
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*.orig

# IDE - VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Other IDEs
.idea/
*.iml
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Certificates / private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Local configuration
*.local.json
*.local.yaml
*.local.yml

# Deployment
.vercel/
.netlify/

# Generated local files
exports/
reports/
tmp/